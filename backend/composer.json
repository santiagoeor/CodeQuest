{
  "name": "codequest/backend",
  "type": "project",
  "description": "API REST de CodeQuest 2026 construida con Laravel",
  "keywords": ["framework", "laravel", "codequest", "devtalles"],
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "start": "php -S 0.0.0.0:8000 -t public public/index.php"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
